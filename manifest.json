{
  "manifest_version": 3,
  "name": "Auto Subtitle Translator",
  "version": "1.0.0",
  "description": "Auto-generate and translate subtitles for any audio content",
  
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "scripting",
    "offscreen"
  ],
  
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["mseTap.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "realTimeTranslate.js", "subtitle.js"],
      "css": ["subtitle-overlay.css"],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Subtitle Translator"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon16.png",
    "48": "icons/icon16.png",
    "128": "icons/icon16.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["subtitle-overlay.css", "injected-script.js", "ocr-frame.html"],
      "matches": ["<all_urls>"]
    }
  ]
}