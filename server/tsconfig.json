{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "../src/translation/**/*", "../src/types/index.ts"],
  "exclude": ["../src/translation/**/__tests__/**", "../src/translation/translationService.ts"]
}
